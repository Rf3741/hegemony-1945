// ==============================================================================
// CONCEITOS - GUERRA FRIA: 1945 (Enciclopédia do Jogo)
// 60 Verbetes Estruturados de Mecânica de Simulação + Contexto Histórico
// ==============================================================================

[
    // --------------------------------------------------------------------------
    // 1. DEMOGRAFIA E SOCIEDADE (01 - 09)
    // --------------------------------------------------------------------------
    Conceito(
        id: "pop",
        nome: "População (Pop)",
        categoria: "demografia_e_sociedade",
        definicao_mecanica: "Unidade atômica da simulação social. Um grupo de indivíduos agrupados na mesma província com a mesma profissão, cultura e religião. Cada Pop possui tamanho demográfico, força de trabalho ativa, dependentes, renda média per capita, taxa de alfabetização e nível de satisfação.",
        contexto_historico: "Em 1945, o mundo contava com cerca de 2,3 bilhões de habitantes, profundamente marcados pelas perdas humanas de mais de 60 milhões de mortos na 2ª Guerra Mundial. No Brasil, a população era de aproximadamente 46 milhões, predominantemente agrária.",
        conceitos_relacionados: ["estrato_social", "padrao_de_vida", "radicalismo_e_lealdade"],
        dica_estrategica: "Monitore o crescimento vegetativo e as migrações das suas Pops para prever onde haverá escassez de operários industriais no futuro.",
    ),
    Conceito(
        id: "estrato_social",
        nome: "Estrato Social",
        categoria: "demografia_e_sociedade",
        definicao_mecanica: "Classificação socioeconômica hierárquica das Pops em três camadas: Estrato Inferior (camponeses, operários não qualificados, trabalhadores rurais), Estrato Médio (engenheiros, burocratas, pequenos comerciantes, clero) e Estrato Superior (capitalistas industriais, latifundiários e financistas). Determina o peso político e a cesta de consumo.",
        contexto_historico: "A dinâmica de classes no pós-guerra opôs o modelo soviético de sociedade sem classes gerida pela Nomenklatura ao modelo de mobilidade social e sociedade de consumo em massa emergente nos Estados Unidos.",
        conceitos_relacionados: ["pop", "padrao_de_vida", "forca_politica"],
        dica_estrategica: "Promover Pops do estrato inferior para o médio através da educação expande o mercado consumidor de bens manufaturados e reduz o radicalismo comunista.",
    ),
    Conceito(
        id: "padrao_de_vida",
        nome: "Padrão de Vida (Standard of Living - SoL)",
        categoria: "demografia_e_sociedade",
        definicao_mecanica: "Escala ordinal de 1 a 99 que reflete o bem-estar material de uma Pop. É calculada pela razão entre os rendimentos líquidos familiares e o custo monetário da sua cesta de bens básicos, serviços e luxos. Cada nível acima de 10 reduz a mortalidade e acima de 15 estimula o consumo de bens secundários.",
        contexto_historico: "A promessa do Padrão de Vida do pós-guerra tornou-se uma das principais armas da Guerra Fria (o 'Sonho Americano' com eletrodomésticos versus a garantia soviética de pleno emprego, moradia básica e saúde universal).",
        conceitos_relacionados: ["radicalismo_e_lealdade", "bens_de_consumo", "inflacao"],
        dica_estrategica: "Quedas abruptas no Padrão de Vida são o gatilho primário para a geração de Radicais. Evite a disparada no preço de pão, feijão e carne.",
    ),
    Conceito(
        id: "radicalismo_e_lealdade",
        nome: "Radicais e Legalistas",
        categoria: "demografia_e_sociedade",
        definicao_mecanica: "Indicadores de polarização política das Pops. Indivíduos tornam-se Radicais quando experimentam queda no Padrão de Vida, desemprego prolongado, discriminação cultural ou quando o governo tenta aprovar leis contrárias aos seus Grupos de Interesse. Radicais alimentam insurreições armadas e greves. Legalistas surgem da prosperidade econômica e elevam a legitimidade do Estado.",
        contexto_historico: "A radicalização operária na Europa pós-1945 levou a grandes vitórias eleitorais comunistas na França e Itália, enquanto no Brasil culminou na greve geral de 1946 e em pressões pelas 'Reformas de Base'.",
        conceitos_relacionados: ["padrao_de_vida", "estabilidade_nacional", "legitimidade_governamental"],
        dica_estrategica: "Baixar temporariamente impostos sobre alimentos ou conceder subsídios pode converter Radicais em cidadãos neutros antes que uma rebelião exploda.",
    ),
    Conceito(
        id: "alfabetizacao",
        nome: "Taxa de Alfabetização",
        categoria: "demografia_e_sociedade",
        definicao_mecanica: "Percentual de indivíduos adultos de uma Pop capazes de ler e escrever. A alfabetização governa a velocidade com que camponeses podem ser promovidos para profissões técnicas (maquinistas, engenheiros, gerentes) e determina o teto de inovação e pesquisa tecnológica da nação.",
        contexto_historico: "Em 1945, os Estados Unidos ostentavam mais de 95% de alfabetização, impulsionada pelo G.I. Bill. O Brasil registrava mais de 50% de analfabetismo, o que excluía a maioria do campesinato do voto pela Constituição de 1934/1946.",
        conceitos_relacionados: ["pop", "metodo_de_producao", "sufragio_e_eleicoes"],
        dica_estrategica: "Sem alta alfabetização, suas indústrias pesadas não conseguirão ativar métodos modernos de produção por falta de engenheiros qualificados.",
    ),
    Conceito(
        id: "assimilacao_cultural",
        nome: "Assimilação Cultural",
        categoria: "demografia_e_sociedade",
        definicao_mecanica: "Taxa com que Pops de culturas minoritárias não discriminadas adotam a cultura primária da nação. A assimilação só ocorre em províncias incorporadas e em indivíduos que não estejam sofrendo discriminação legal ativa pelo regime.",
        contexto_historico: "No Brasil, o Estado Novo implementou a campanha de nacionalização forçada durante a 2ª Guerra Mundial, fechando escolas alemãs, italianas e japonesas e proibindo jornais em língua estrangeira.",
        conceitos_relacionados: ["pop", "conversao_religiosa", "estabilidade_nacional"],
        dica_estrategica: "Leis de cidadania mais tolerantes evitam revoltas separatistas e aceleram a integração econômica das populações imigrantes.",
    ),
    Conceito(
        id: "conversao_religiosa",
        nome: "Conversão Religiosa",
        categoria: "demografia_e_sociedade",
        definicao_mecanica: "Processo pelo qual membros de uma fé minoritária adotam a religião oficial do Estado. Depende da lei de religião vigente (Estado Confessional, Liberdade Religiosa ou Ateísmo de Estado).",
        contexto_historico: "Na União Soviética, o ateísmo de Estado foi a política oficial, embora Stalin tenha reabilitado a Igreja Ortodoxa Russa em 1943 para mobilizar o fervor patriótico contra o invasor nazista. No Brasil, a hegemonia católica moldava as instituições públicas.",
        conceitos_relacionados: ["pop", "grupo_de_interesse", "estabilidade_nacional"],
        dica_estrategica: "Promover secularismo sem apoio do Clero pode colapsar a legitimidade do seu governo e provocar motins em regiões rurais conservadoras.",
    ),
    Conceito(
        id: "migracao_interna",
        nome: "Migração Interna e Êxodo Rural",
        categoria: "demografia_e_sociedade",
        definicao_mecanica: "Deslocamento de Pops entre províncias de um mesmo país em busca de melhores salários e terras livres. A 'Atratividade Migratória' provincial é impulsionada por vagas de emprego ociosas, terras aráveis disponíveis e baixo radicalismo local.",
        contexto_historico: "O pós-1945 testemunhou intensas ondas migratórias de camponeses nordestinos para os polos industriais do Sudeste (São Paulo e Rio de Janeiro), assim como a migração afro-americana do sul dos EUA para as fábricas do norte e oeste (Great Migration).",
        conceitos_relacionados: ["terra_aravel", "metodo_de_producao", "padrao_de_vida"],
        dica_estrategica: "Construir indústrias em províncias de alta população agrária evita congestionamentos e favelização nas capitais.",
    ),
    Conceito(
        id: "imigracao_internacional",
        nome: "Imigração Internacional",
        categoria: "demografia_e_sociedade",
        definicao_mecanica: "Fluxo de Pops de nações estrangeiras empobrecidas ou em guerra para países com alto padrão de vida, fronteiras abertas e leis de cidadania tolerantes. Gera expansão rápida da base de força de trabalho.",
        contexto_historico: "Milhões de 'Displaced Persons' (refugiados europeus) emigraram no imediato pós-guerra para as Américas e a Austrália fugindo da devastação dos campos de concentração e das ruínas da Europa Central.",
        conceitos_relacionados: ["pop", "assimilacao_cultural", "padrao_de_vida"],
        dica_estrategica: "Se sua economia está em pleno emprego com falta de braços fabris, promulgar leis de Fronteiras Abertas atrairá imigrantes qualificados.",
    ),

    // --------------------------------------------------------------------------
    // 2. ECONOMIA E MERCADO (10 - 20)
    // --------------------------------------------------------------------------
    Conceito(
        id: "mercado_nacional",
        nome: "Mercado Nacional",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Rede unificada de comércio que integra todas as províncias de um país e seus parceiros de união aduaneira. No mercado, as ofertas e demandas de todas as províncias com 100% de acesso ao mercado são somadas para determinar o preço único de referência.",
        contexto_historico: "A consolidação de um mercado nacional integrado no Brasil foi acelerada na década de 1940 com o avanço da malha rodoviária e a unificação das tarifas entre os estados federados.",
        conceitos_relacionados: ["acesso_ao_mercado", "preco_de_mercado", "infraestrutura_de_transporte"],
        dica_estrategica: "Conectar províncias isoladas ao seu mercado nacional expande a oferta agregada e reduz os custos industriais das metrópoles.",
    ),
    Conceito(
        id: "acesso_ao_mercado",
        nome: "Acesso ao Mercado Provincial",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Percentual (0% a 100%) que define o grau de integração física de uma província ao Mercado Nacional. É calculado pela razão entre a Infraestrutura disponível e o Uso de Infraestrutura demandado pelas fábricas e fazendas locais. Se a infraestrutura for insuficiente, o Acesso ao Mercado cai proporcionalmente.",
        contexto_historico: "O interior do Brasil (Goiás, Mato Grosso, Amazônia) e da Sibéria soviética sofriam com severo estrangulamento de transporte em 1945, limitando o escoamento de minérios e produtos agrícolas.",
        conceitos_relacionados: ["mercado_nacional", "infraestrutura_de_transporte", "capacidade_portuaria"],
        dica_estrategica: "Nunca construa novas fábricas em uma província com Acesso ao Mercado abaixo de 100% sem antes expandir ferrovias ou portos.",
    ),
    Conceito(
        id: "preco_de_mercado",
        nome: "Preço de Mercado",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Preço monetário vigente de uma mercadoria no Mercado Nacional. Varia dinamicamente entre -75% e +75% do Preço Base do bem, em função da razão entre Oferta Total e Demanda Total. Se Oferta = Demanda, o preço é idêntico ao Preço Base.",
        contexto_historico: "No pós-guerra, os preços internacionais de commodities e matérias-primas oscilaram conforme as demandas da reconstrução europeia e a corrida armamentista inicial.",
        conceitos_relacionados: ["preco_base", "oferta_e_demanda", "inflacao"],
        dica_estrategica: "Bens intermediários (como aço e carvão) com preço de mercado elevado sufocam a lucratividade de todas as indústrias manufatureiras finais.",
    ),
    Conceito(
        id: "preco_base",
        nome: "Preço Base de Referência",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Constante monetária que representa o valor de troca natural de uma unidade da mercadoria sob condições ideais de equilíbrio perfeito de oferta e demanda. Serve de âncora para os cálculos de PIB e custo de vida.",
        contexto_historico: "O sistema de preços relativos em economias de mercado reflete a escassez de trabalho e capital, enquanto em economias planificadas soviéticas os preços eram fixados arbitrariamente pelo Estado.",
        conceitos_relacionados: ["preco_de_mercado", "oferta_e_demanda"],
        dica_estrategica: "Use o preço base para comparar rapidamente a rentabilidade relativa de diferentes cadeias produtivas.",
    ),
    Conceito(
        id: "oferta_e_demanda",
        nome: "Equilíbrio de Oferta e Demanda",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Mecanismo que governa a flutuação de preços. A oferta compreende toda a produção de prédios domésticos somada às importações. A demanda engloba o consumo intermediário das fábricas, o consumo das famílias (Pops) e as exportações.",
        contexto_historico: "A teoria econômica neoclássica nos EUA confrontava o dirigismo keynesiano ocidental e a planificação material centralizada do Gosplan soviético em 1945.",
        conceitos_relacionados: ["preco_de_mercado", "bens_de_consumo", "bens_industriais"],
        dica_estrategica: "Um ligeiro excesso de oferta (preço em torno de -10% do base) estimula o consumo e mantém os custos de expansão baixos.",
    ),
    Conceito(
        id: "bens_comercializaveis",
        nome: "Bens Comercializáveis e Bens Locais",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Classificação que define a mobilidade de um produto. Bens comercializáveis (aço, café, petróleo, automóveis) podem circular livremente entre províncias e mercados estrangeiros. Bens locais (serviços de eletricidade, transporte urbano, água e construção) precisam ser produzidos e consumidos na mesma província.",
        contexto_historico: "A eletricidade gerada pelas usinas hidrelétricas brasileiras nascentes (como Light e Usina de Cubatão) era um bem estritamente regional, incapaz de ser transmitida a longas distâncias interestaduais.",
        conceitos_relacionados: ["bens_industriais", "acesso_ao_mercado", "infraestrutura_de_transporte"],
        dica_estrategica: "Certifique-se de que cada província industrializada possua sua própria produção local de serviços elétricos e transporte.",
    ),
    Conceito(
        id: "bens_de_consumo",
        nome: "Bens de Consumo Básico",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Mercadorias indispensáveis para a sobrevivência e reprodução das famílias: grãos alimentícios, carne, tecidos de vestuário, carvão residencial e móveis rústicos. Têm peso desproporcional na cesta dos estratos inferiores.",
        contexto_historico: "O racionamento de carne, trigo, açúcar e sapatos permaneceu em vigor em boa parte da Europa e Ásia até o fim da década de 1940 devido à escassez de guerra.",
        conceitos_relacionados: ["padrao_de_vida", "radicalismo_e_lealdade", "substituicao_de_importacoes"],
        dica_estrategica: "Manter a farinha e o arroz abundantes é a melhor vacina contra ondas de agitação e levantes grevistas nos bairros proletários.",
    ),
    Conceito(
        id: "bens_industriais",
        nome: "Bens Industriais Intermediários",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Produtos utilizados como insumos essenciais em outras cadeias fabris: carvão mineral, minério de ferro, lingotes de aço, ferramentas mecânicas, cimento e produtos químicos.",
        contexto_historico: "A indústria pesada soviética (Magnitogorsk, Donbass) e o Cinturão de Ferrugem norte-americano (Rust Belt) foram os alicerces materiais da vitória militar sobre o Eixo.",
        conceitos_relacionados: ["bens_estrategicos", "setor_de_construcao", "metodo_de_producao"],
        dica_estrategica: "Uma nação sem produção própria de ferramentas mecânicas fica vulnerável a embargos econômicos em caso de conflito.",
    ),
    Conceito(
        id: "bens_de_luxo",
        nome: "Bens de Luxo e Status",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Mercadorias de alto valor e consumo conspícuo: automóveis de passeio, roupas finas de seda, aparelhos de rádio luxuosos, porcelanas e charutos. Consumidos predominantemente pelas classes ricas e médias altas.",
        contexto_historico: "Na década de 1950, a posse de geladeiras, televisores e carros sedã converteu-se no símbolo supremo da superioridade do modo de vida capitalista nos EUA.",
        conceitos_relacionados: ["estrato_social", "padrao_de_vida", "imposto_sobre_consumo"],
        dica_estrategica: "Tributar pesadamente o consumo de bens de luxo é uma maneira excelente de arrecadar receita fiscal sem empobrecer as massas trabalhadoras.",
    ),
    Conceito(
        id: "bens_estrategicos",
        nome: "Bens Estratégicos e Críticos",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Recursos essenciais para a indústria bélica e segurança de Estado: petróleo refinado, minério de urânio enriquecível, borracha sintética e natural, ligas de níquel e motores aeronáuticos.",
        contexto_historico: "A campanha 'O Petróleo é Nosso' no Brasil de 1945 a 1953 refletiu a disputa sobre o monopólio estatal do óleo bruto, culminando na fundação da Petrobras.",
        conceitos_relacionados: ["bens_industriais", "monopolio_nuclear", "esfera_de_influencia"],
        dica_estrategica: "Acumule estoques de urânio e petróleo para evitar que um bloqueio naval paralise completamente suas forças militares.",
    ),
    Conceito(
        id: "inflacao",
        nome: "Inflação e Perda do Poder de Compra",
        categoria: "economia_e_mercado",
        definicao_mecanica: "Taxa anual de aumento generalizado no nível de preços da economia. Ocorre quando a emissão de moeda sem lastro supera o crescimento do PIB ou quando há choques severos de oferta em bens básicos.",
        contexto_historico: "A hiperinflação castigou a Alemanha em 1945-1948 (até a reforma monetária do Marco Alemão) e a China nacionalista do Kuomintang, pavimentando a vitória dos comunistas de Mao Tsé-Tung.",
        conceitos_relacionados: ["padrao_de_vida", "tesouro_nacional", "padrao_bretton_woods"],
        dica_estrategica: "Se a inflação anual ultrapassar 10%, adote austeridade fiscal e eleve taxas de juros para recompor o poder de compra das Pops.",
    ),

    // --------------------------------------------------------------------------
    // 3. PRODUÇÃO E INFRAESTRUTURA (21 - 28)
    // --------------------------------------------------------------------------
    Conceito(
        id: "setor_de_construcao",
        nome: "Setor e Capacidade de Construção",
        categoria: "producao_e_infraestrutura",
        definicao_mecanica: "Conjunto de prédios públicos e privados que geram 'Pontos de Construção' diários. Cada ponto ativo demanda cimento, ferro, aço e madeira do mercado e consome verba pública do Tesouro.",
        contexto_historico: "A reconstrução pós-guerra na Europa Ocidental e a expansão fabril no interior do Brasil demandaram mobilização gigantesca da construção civil nos anos 1940.",
        conceitos_relacionados: ["fila_de_construcao", "bens_industriais", "tesouro_nacional"],
        dica_estrategica: "Ajuste o número de prédios do setor de construção de acordo com o superávit fiscal; desative-os temporariamente se entrar em déficit.",
    ),
    Conceito(
        id: "fila_de_construcao",
        nome: "Fila de Construção Pública e Privada",
        categoria: "producao_e_infraestrutura",
        definicao_mecanica: "Lista sequencial de prédios em processo de edificação. A capacidade nacional de construção é alocada entre o fundo de investimento do setor privado (capitalistas e latifundiários) e os decretos de obras públicas do jogador.",
        contexto_historico: "Enquanto na União Soviética o Estado alocava 100% da construção conforme os Planos Quinquenais, nos EUA mais de 70% da construção era financiada pelo capital privado corporativo.",
        conceitos_relacionados: ["setor_de_construcao", "metodo_de_producao", "tesouro_nacional"],
        dica_estrategica: "Reordene a fila para priorizar obras de infraestrutura de transporte e siderurgias que aliviem gargalos produtivos imediatos.",
    ),
    Conceito(
        id: "metodo_de_producao",
        nome: "Métodos de Produção (Production Methods)",
        categoria: "producao_e_infraestrutura",
        definicao_mecanica: "Conjunto de tecnologias e rotinas organizacionais selecionadas em um prédio. Define os insumos requeridos (ex: carvão vs eletricidade), os bens finais produzidos, a intensidade de mão de obra e o regime de propriedade dos lucros.",
        contexto_historico: "A modernização técnica do pós-guerra generalizou o fordismo, a química sintética do petróleo e os fornos a oxigênio básico na siderurgia global.",
        conceitos_relacionados: ["automacao_industrial", "produtividade_do_trabalho", "alfabetizacao"],
        dica_estrategica: "Antes de alterar um método de produção para um insumo moderno (como petróleo), verifique se há oferta farta no mercado nacional para evitar apagões industriais.",
    ),
    Conceito(
        id: "automacao_industrial",
        nome: "Automação e Eletrificação",
        categoria: "producao_e_infraestrutura",
        definicao_mecanica: "Adoção de métodos produtivos que consomem eletricidade e ferramentas mecânicas para reduzir o número de operários braçais necessários por unidade de produto fabricado.",
        contexto_historico: "A linha de montagem automatizada em Detroit permitiu à indústria automobilística americana atingir patamares sem precedentes de produtividade na década de 1950.",
        conceitos_relacionados: ["metodo_de_producao", "produtividade_do_trabalho", "radicalismo_e_lealdade"],
        dica_estrategica: "A automação é recomendada em nações com escassez de população (como os EUA pós-mobilização), mas deve ser cautelosa onde há excesso de desempregados rurais.",
    ),
    Conceito(
        id: "infraestrutura_de_transporte",
        nome: "Infraestrutura de Transporte e Ferrovias",
        categoria: "producao_e_infraestrutura",
        definicao_mecanica: "Capacidade física de transporte de uma província, medida em pontos de infraestrutura gerados por rodovias pavimentadas, ferrovias a vapor ou elétricas e canais fluviais navegáveis.",
        contexto_historico: "No Brasil de 1945, ferrovias de diferentes bitolas e estradas de terra precárias atrasavam o comércio interestadual. O plano rodoviário do pós-guerra buscou conectar o litoral ao interior.",
        conceitos_relacionados: ["acesso_ao_mercado", "mercado_nacional", "capacidade_portuaria"],
        dica_estrategica: "Expandir ferrovias é o investimento mais seguro para valorizar terras e elevar o rendimento de fazendas e minas distantes.",
    ),
    Conceito(
        id: "capacidade_portuaria",
        nome: "Capacidade Portuária e Cabotagem",
        categoria: "producao_e_infraestrutura",
        definicao_mecanica: "Métrica provincial que governa o volume máximo de mercadorias que podem ser exportadas ou importadas por vias marítimas e conecta províncias costeiras em rotas de cabotagem.",
        contexto_historico: "O Porto de Santos e o Porto do Rio de Janeiro eram as gargantas por onde escoavam as colheitas de café e entravam as máquinas norte-americanas essenciais à industrialização brasileira.",
        conceitos_relacionados: ["infraestrutura_de_transporte", "acesso_ao_mercado", "tarifas_alfandegarias"],
        dica_estrategica: "Portos modernos geram comboios navais adicionais, fundamentais para manter o comércio aberto em tempos de crise internacional.",
    ),
    Conceito(
        id: "terra_aravel",
        nome: "Terra Arável e Agricultura de Subsistência",
        categoria: "producao_e_infraestrutura",

        categoria: "sociedade",
        tipo_alerta: "critico",
        titulo_template: "GREVE GERAL OPERÁRIA: {provincia}",
        mensagem_template: "Milhares de operários liderados pela central sindical dos {sindicato_lider} cruzaram os braços na província de {provincia} ({pais}), paralisando o transporte ferroviário e os fornos industriais em protesto contra {reivindicacao_greve}.",
        placeholders: ["sindicato_lider", "provincia", "pais", "reivindicacao_greve"],

    ModeloMensagem(
        id: "msg_incidente_fronteira",
        categoria: "militar",
        tipo_alerta: "importante",
        titulo_template: "Atrito Armado na Fronteira",
        mensagem_template: "Patrulhas de fronteira de {pais_a} e {pais_b} trocaram disparos na região fronteiriça de {regiao_fronteira}. O incidente resultou em baixas militares e elevou perigosamente a tensão bilateral entre as capitais.",
        placeholders: ["pais_a", "pais_b", "regiao_fronteira"],
        som_efeito: "alarme_fronteira",
    ),
    ModeloMensagem(
        id: "msg_bloqueio_terrestre_ou_aereo",
        categoria: "militar",
        tipo_alerta: "critico",
        titulo_template: "BLOQUEIO DE ACESSO: {cidade_afetada}",
        mensagem_template: "As forças militares de {pais_bloqueador} interditaram todas as ferrovias, canais e estradas que dão acesso à cidade de {cidade_afetada}. Os governos aliados articulam uma ponte aérea emergencial para evitar o desabastecimento.",
        placeholders: ["pais_bloqueador", "cidade_afetada"],
        som_efeito: "sirene_ponte_aerea",
    ),


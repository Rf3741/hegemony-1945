        categoria: "sociedade",
        tipo_alerta: "critico",
        titulo_template: "INSURREIÇÃO CAMPONESA: {provincia}",
        mensagem_template: "Camponeses e meeiros da província de {provincia} ({pais}) rebelaram-se contra os grandes proprietários de terras, ocupando latifúndios e erguendo barricadas armadas sob a bandeira de {movimento_rural}.",
        placeholders: ["provincia", "pais", "movimento_rural"],
        som_efeito: "tiros_fuzil",

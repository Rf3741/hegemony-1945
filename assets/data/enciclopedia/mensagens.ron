    ModeloMensagem(
        id: "msg_ajuda_financeira_concedida",
        categoria: "diplomacia",
        tipo_alerta: "informativo",
        titulo_template: "Concessão de Ajuda Financeira",
        mensagem_template: "O governo de {pais_doador} aprovou um pacote extraordinário de cooperação econômica no valor de US$ {valor_milhoes}M em benefício de {pais_beneficiario}, visando a reconstrução de infraestruturas estratégicas.",
        placeholders: ["pais_doador", "valor_milhoes", "pais_beneficiario"],
        som_efeito: "ouro_descoberta",
    ),
    ModeloMensagem(
        id: "msg_teste_nuclear_detonado",
        categoria: "diplomacia",
        tipo_alerta: "critico",
        titulo_template: "DETONAÇÃO ATÔMICA DETECTADA: {pais_detonador}",
        mensagem_template: "Sismógrafos ao redor do globo registraram uma detonação nuclear conduzida no campo de provas de {pais_detonador}. Cientistas confirmaram o sucesso do artefato e o Relógio do Juízo Final avançou em {minutos_avanco} minutos rumo à meia-noite.",
        placeholders: ["pais_detonador", "minutos_avanco"],
        som_efeito: "explosao_nuclear",

        titulo_template: "CRISE DE FOME E DESABASTECIMENTO: {provincia}",
        mensagem_template: "A quebra nas colheitas somada ao bloqueio de ferrovias causou uma severa crise de escassez alimentar na província de {provincia} ({pais}). O índice de mortalidade disparou e milhares de famílias abandonam suas vilas.",
        placeholders: ["provincia", "pais"],
        som_efeito: "alarme_tumulto",

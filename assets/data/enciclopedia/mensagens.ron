// ==============================================================================
// MENSAGENS E NOTIFICAÇÕES - GUERRA FRIA: 1945
// Modelos de Notificação de Eventos com Placeholders Intercaláveis
// ==============================================================================

[
    // --------------------------------------------------------------------------
    // 1. EVENTOS POLÍTICOS E LEGISLATIVOS
    // --------------------------------------------------------------------------
    ModeloMensagem(
        id: "msg_lei_aprovada",
        categoria: "politica",
        tipo_alerta: "importante",
        titulo_template: "Reforma Legal: {pais}",
        mensagem_template: "O parlamento de {pais} concluiu a tramitação e promulgou oficialmente a lei '{lei}'. A medida fortaleceu a influência de {grupo_favorecido}, mas despertou protestos veementes entre {grupo_opositor}.",
        placeholders: ["pais", "lei", "grupo_favorecido", "grupo_opositor"],
        som_efeito: "carimbo_decreto",
    ),
    ModeloMensagem(
        id: "msg_lei_rejeitada",
        categoria: "politica",
        tipo_alerta: "importante",
        titulo_template: "Fracasso Legislativo: {pais}",
        mensagem_template: "A proposta de promulgação da lei '{lei}' foi derrotada na câmara legislativa de {pais} após forte articulação liderada por {grupo_opositor}. A legitimidade do gabinete executivo sofreu um abalo de {penalidade_legitimidade}%.",
        placeholders: ["pais", "lei", "grupo_opositor", "penalidade_legitimidade"],
        som_efeito: "martelo_rejeitado",
    ),
    ModeloMensagem(
        id: "msg_lei_emenda_debate",
        categoria: "politica",
        tipo_alerta: "informativo",
        titulo_template: "Debate Parlamentar Intenso: {pais}",
        mensagem_template: "Durante a segunda leitura da lei '{lei}' em {pais}, o líder dos {grupo_opositor} apresentou uma emenda de redação exigindo compensações tributárias para que a votação avance.",
        placeholders: ["pais", "lei", "grupo_opositor"],
        som_efeito: "teletipo_leve",
    ),
    ModeloMensagem(
        id: "msg_gabinete_reorganizado",
        categoria: "politica",
        tipo_alerta: "informativo",
        titulo_template: "Reorganização Ministerial: {pais}",
        mensagem_template: "O chefe de governo de {pais} empossou novos ministros para acomodar {grupo_entrante} na coalizão oficial. Os representantes de {grupo_sainte} foram exonerados, passando à oposição formal.",
        placeholders: ["pais", "grupo_entrante", "grupo_sainte"],
        som_efeito: "papel_despacho",
    ),
    ModeloMensagem(
        id: "msg_eleicoes_presidenciais",
        categoria: "politica",
        tipo_alerta: "importante",
        titulo_template: "Resultado Eleitoral: {pais}",
        mensagem_template: "Foram apuradas as urnas da eleição geral em {pais}. O candidato {candidato_vencedor}, apoiado por {partido_vencedor}, obteve a maioria dos sufrágios com {percentual_votos}% dos votos válidos e assume o governo da nação.",
        placeholders: ["pais", "candidato_vencedor", "partido_vencedor", "percentual_votos"],
        som_efeito: "fanfarra_eleicao",
    ),
    ModeloMensagem(
        id: "msg_golpe_militar_consumado",
        categoria: "politica",
        tipo_alerta: "critico",
        titulo_template: "GOLPE DE ESTADO: {pais}",
        mensagem_template: "Tropas rebeldes comandadas pelo general {lider_golpe} cercaram a sede do governo em {pais}, suspendendo a constituição e dissolvendo o congresso nacional. Uma junta de salvação militar assumiu o comando supremo.",
        placeholders: ["pais", "lider_golpe"],
        som_efeito: "alarme_golpe",
    ),
    ModeloMensagem(
        id: "msg_conspiracao_golpe_frustrada",
        categoria: "politica",
        tipo_alerta: "importante",
        titulo_template: "Conspiração Desarticulada: {pais}",
        mensagem_template: "O serviço de inteligência de {pais} descobriu e neutralizou uma conspiração de oficiais dissidentes liderada por {lider_conspiracao}. Os envolvidos foram presos e a estabilidade foi parcialmente restabelecida.",
        placeholders: ["pais", "lider_conspiracao"],
        som_efeito: "sirene_policial",
    ),

    // --------------------------------------------------------------------------
    // 2. EVENTOS ECONÔMICOS E MERCADOS
    // --------------------------------------------------------------------------
    ModeloMensagem(
        id: "msg_predio_inaugurado",
        categoria: "economia",
        tipo_alerta: "oportunidade",
        titulo_template: "Obra Concluída: {provincia}",
        mensagem_template: "A construção de '{predio}' na província de {provincia} ({pais}) foi concluída com sucesso pelos engenheiros. A unidade fabril já iniciou a contratação de mão de obra e a produção de {bem_produzido}.",
        placeholders: ["predio", "provincia", "pais", "bem_produzido"],
        som_efeito: "sirene_fabrica",
    ),
    ModeloMensagem(
        id: "msg_escassez_insumo_critico",
        categoria: "economia",
        tipo_alerta: "critico",
        titulo_template: "ESCASSEZ CRÍTICA: {bem}",
        mensagem_template: "O mercado de {pais} atingiu um déficit agudo no suprimento de {bem}. O preço subiu para +{aumento_preco}% acima do valor base, paralisando a produção em {predio_afetado} e ameaçando demissões em massa.",
        placeholders: ["pais", "bem", "aumento_preco", "predio_afetado"],
        som_efeito: "alerta_buzina",
    ),
    ModeloMensagem(
        id: "msg_rota_comercial_firmada",
        categoria: "economia",
        tipo_alerta: "informativo",
        titulo_template: "Nova Rota Comercial: {bem}",
        mensagem_template: "Mercadores de {pais} estabeleceram uma nova rota de {tipo_fluxo} de {bem} com o mercado de {pais_parceiro}. O volume inicial despachado é de {volume_semanal} unidades por semana.",
        placeholders: ["pais", "tipo_fluxo", "bem", "pais_parceiro", "volume_semanal"],
        som_efeito: "apito_navio",
    ),
    ModeloMensagem(
        id: "msg_rota_comercial_bloqueada",
        categoria: "economia",
        tipo_alerta: "importante",
        titulo_template: "Rota Marítima Interrompida: {bem}",
        mensagem_template: "A frota mercante de {pais} teve sua rota de {bem} em direção a {pais_destino} bloqueada devido à interdição hostil exercida por {pais_bloqueador}. Os navios retornaram aos portos de origem.",
        placeholders: ["pais", "bem", "pais_destino", "pais_bloqueador"],
        som_efeito: "alarme_naval",
    ),
    ModeloMensagem(
        id: "msg_tesouro_insolvente",
        categoria: "economia",
        tipo_alerta: "critico",
        titulo_template: "INSOLVÊNCIA FISCAL: {pais}",
        mensagem_template: "As reservas do Tesouro Nacional de {pais} esgotaram-se totalmente e o limite de endividamento prudencial foi ultrapassado. Bancos internacionais rebaixaram a nota soberana e exigem taxa de juros de {taxa_juros}% sobre novos empréstimos.",
        placeholders: ["pais", "taxa_juros"],
        som_efeito: "sino_falencia",
    ),
    ModeloMensagem(
        id: "msg_hiperinflacao_descontrolada",
        categoria: "economia",
        tipo_alerta: "critico",
        titulo_template: "CRISE DE HIPERINFLAÇÃO: {pais}",
        mensagem_template: "A taxa de inflação em {pais} atingiu estarrecedores {inflacao_pct}% ao ano. O dinheiro de papel perdeu o lastro prático nas cidades e os trabalhadores entraram em greve exigindo reajustes diários de sobrevivência.",
        placeholders: ["pais", "inflacao_pct"],
        som_efeito: "alerta_tumulto",
    ),
    ModeloMensagem(
        id: "msg_descoberta_jazida",
        categoria: "economia",
        tipo_alerta: "oportunidade",
        titulo_template: "Nova Jazida Mineral: {recurso}",
        mensagem_template: "Expedições geológicas confirmaram a descoberta de ricas reservas naturais de {recurso} no subsolo da província de {provincia} ({pais}). O potencial de expansão extrativa aumentou em {pontos_capacidade} níveis.",
        placeholders: ["recurso", "provincia", "pais", "pontos_capacidade"],
        som_efeito: "ouro_descoberta",
    ),

    // --------------------------------------------------------------------------
    // 3. EVENTOS DIPLOMÁTICOS E GEOPOLÍTICOS
    // --------------------------------------------------------------------------
    ModeloMensagem(
        id: "msg_ultimato_diplomatico",
        categoria: "diplomacia",
        tipo_alerta: "critico",
        titulo_template: "ULTIMATO DIPLOMÁTICO: {pais_emissor}",
        mensagem_template: "O embaixador de {pais_emissor} entregou uma nota oficial intransigente ao governo de {pais_alvo}, exigindo {exigencia_diplomatica} sob a ameaça explícita de intervenção militar se o prazo de {dias_prazo} dias não for respeitado.",
        placeholders: ["pais_emissor", "pais_alvo", "exigencia_diplomatica", "dias_prazo"],
        som_efeito: "tambor_guerra",
    ),
    ModeloMensagem(
        id: "msg_tratado_seguranca_assinado",
        categoria: "diplomacia",
        tipo_alerta: "importante",
        titulo_template: "Pacto Internacional: {tratado}",
        mensagem_template: "Os representantes plenipotenciários de {pais_lider} e {pais_signatario} assinaram solenemente o '{tratado}', consagrando a mútua cooperação militar e a garantia recíproca de integridade territorial.",
        placeholders: ["pais_lider", "pais_signatario", "tratado"],
        som_efeito: "acordo_solene",
    ),
    ModeloMensagem(
        id: "msg_veto_conselho_seguranca",
        categoria: "diplomacia",
        tipo_alerta: "importante",
        titulo_template: "Veto no Conselho de Segurança da ONU",
        mensagem_template: "A delegação diplomática de {pais_vetante} acionou seu poder de Veto permanente no Conselho de Segurança, barrando de forma irrecorrível a resolução sobre {assunto_resolucao} proposta por {pais_proponente}.",
        placeholders: ["pais_vetante", "assunto_resolucao", "pais_proponente"],
        som_efeito: "martelo_rejeitado",
    ),
    ModeloMensagem(
        id: "msg_expulsao_diplomatas",
        categoria: "diplomacia",
        tipo_alerta: "importante",
        titulo_template: "Crise Diplomática: {pais_emissor} x {pais_alvo}",
        mensagem_template: "O Ministério das Relações Exteriores de {pais_emissor} declarou o embaixador de {pais_alvo} como 'Persona Non Grata' e concedeu 48 horas para a evacuação de todo o corpo consular, após acusações de {motivo_crise}.",
        placeholders: ["pais_emissor", "pais_alvo", "motivo_crise"],
        som_efeito: "teletipo_urgente",
    ),
    ModeloMensagem(
        id: "msg_adesao_esfera_influencia",
        categoria: "diplomacia",
        tipo_alerta: "oportunidade",
        titulo_template: "Alinhamento Geopolítico: {pais_satelite}",
        mensagem_template: "O governo de {pais_satelite} integrou-se formalmente à Esfera de Influência liderada por {pais_potencia}, assinando protocolos de prioridade de fornecimento de matérias-primas e assessoria militar conjunta.",
        placeholders: ["pais_satelite", "pais_potencia"],
        som_efeito: "acordo_solene",
    ),
    ModeloMensagem(
        id: "msg_ruptura_esfera_influencia",
        categoria: "diplomacia",
        tipo_alerta: "critico",
        titulo_template: "Deserção de Bloco: {pais_satelite}",
        mensagem_template: "Em pronunciamento histórico transmitido por rádio, o líder de {pais_satelite} anunciou o rompimento unilateral dos laços tutelares com {pais_antiga_potencia}, declarando sua soberania plena e expulsando conselheiros militares.",
        placeholders: ["pais_satelite", "pais_antiga_potencia"],
        som_efeito: "alarme_golpe",

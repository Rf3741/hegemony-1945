        categoria: "diplomacia",
        tipo_alerta: "importante",
        titulo_template: "Tratado de Paz: {guerra}",
        mensagem_template: "A guerra terminou com uma proposta de {proponente}. Termos executados: {termos}.",
        placeholders: ["guerra", "proponente", "termos"],
        som_efeito: "acordo_solene",
    ),
    ModeloMensagem(
        id: "msg_independencia",
        categoria: "diplomacia",
        tipo_alerta: "importante",
        titulo_template: "Independência: {pais}",

// ==============================================================================
// TUTORIAL - GUERRA FRIA: 1945 (Estilo Victoria 3)
// 25 Passos Guiados de Aprendizado para Brasil (BRA) e Estados Unidos (USA)
// ==============================================================================

[
    PassoTutorial(
        id: "passo_01_bem_vindo_a_1945",
        ordem: 1,
        titulo: "O Amanhecer de uma Nova Era: 1º de Janeiro de 1945",
        categoria: "interface",
        pais_foco: None,
        texto: "Bem-vindo ao gabinete de comando em 1º de janeiro de 1945. A Segunda Guerra Mundial aproxima-se de seu clímax na Europa e no Pacífico, e o mundo começa a se reorganizar sob uma nova e perigosa realidade: a Guerra Fria. À frente dos Estados Unidos (USA), você lidera a maior potência industrial e naval do planeta, fiadora do sistema capitalista global e arquiteta da ordem de Bretton Woods. À frente do Brasil (BRA), você conduz a nação mais populosa da América Latina na transição dramática do Estado Novo varguista rumo à redemocratização, buscando industrializar o país e equilibrar sua soberania com o alinhamento hemisférico.",
        objetivo: "Observe a tela inicial, o painel superior (Top Bar) e identifique as informações essenciais do seu país.",
        elemento_hud: "top_bar_bloco_identidade",
        dica: "Guerra Fria é uma simulação em tempo real com pausa. Você nunca deve ter pressa: o destino de milhões de cidadãos depende de decisões serenas de gabinete.",
    ),
    PassoTutorial(
        id: "passo_02_mapa_e_navegacao",
        ordem: 2,
        titulo: "Navegação Cartográfica e Províncias",
        categoria: "interface",
        pais_foco: None,
        texto: "O mapa mundi é a sua mesa de operações estratégicas. Ele é dividido em dezenas de províncias históricas, cada uma possuindo seu próprio relevo, população, prédios produtivos e infraestrutura de transporte. Utilize o botão esquerdo do mouse para selecionar uma província e inspecionar seu perfil socioeconômico. Você pode navegar arrastando com o botão direito ou usando as teclas direcionais (W, A, S, D). A roda do mouse controla o nível de aproximação (zoom).",
        objetivo: "Selecione a capital do seu país no mapa: Washington D.C. se estiver jogando com os EUA, ou o Distrito Federal (Rio de Janeiro) se estiver jogando com o Brasil.",
        elemento_hud: "mapa_principal",
        dica: "Pressione a tecla 'C' ou o botão [C] no minimapa a qualquer instante para recentralizar imediatamente a visão do mapa sobre a sua capital nacional.",
    ),
    PassoTutorial(
        id: "passo_03_tempo_e_pausa",
        ordem: 3,
        titulo: "O Fluxo do Tempo e a Pausa Tática",
        categoria: "tempo",
        pais_foco: None,
        texto: "No canto superior direito da tela, você encontra o relógio do jogo e os controles de velocidade. A simulação avança dia a dia. Ao iniciar, o jogo está pausado. Você pode alternar entre pausa e andamento pressionando a barra de ESPAÇO. Os botões de velocidade variam de 1x (um dia a cada dois segundos, ideal para microgestão de crises diplomáticas) até 5x (velocidade máxima para acompanhar longos ciclos de construção fabril e colheitas agrícolas).",
        objetivo: "Pressione a barra de ESPAÇO para despausar a simulação por alguns segundos, observe a virada dos dias e pause novamente.",
        elemento_hud: "top_bar_bloco_tempo",
        dica: "Nunca deixe o jogo rodar em velocidade alta sem vigilância. Alertas urgentes, desabastecimento de bens essenciais ou greves gerais exigem pausa imediata para análise.",
    ),
    PassoTutorial(
        id: "passo_04_modos_de_mapa",
        ordem: 4,
        titulo: "Filtros Estratégicos: Modos de Mapa",
        categoria: "interface",
        pais_foco: None,
        texto: "Logo acima do minimapa tático, no canto inferior direito, repousa o seletor de Modos de Mapa. O modo Político (tecla Q) mostra as fronteiras e estados soberanos. O modo Ideológico (W) colore o globo pelas esferas da Guerra Fria: azul para o Bloco Ocidental, vermelho para o Bloco Socialista e oliva para os Não-Alinhados. O modo Econômico (E) revela a renda e o PIB das províncias. Esferas (R) mapeia pactos e garantias. Tensão (T) expõe focos de guerra civil e insurreição, enquanto Recursos (Y) evidencia jazidas de urânio, petróleo, minério de ferro e borracha.",
        objetivo: "Alterne entre os modos Político (Q) e Ideológico (W) para visualizar o tabuleiro da bipolaridade global emergente.",
        elemento_hud: "seletor_modos_mapa",
        dica: "Se você joga com o Brasil, o modo Ideológico mostra a firme inserção sul-americana no raio de influência pró-ocidental, com focos de agitação operária nas grandes capitais.",
    ),
    PassoTutorial(
        id: "passo_05_estrutura_das_pops",
        ordem: 5,
        titulo: "A Alma da Nação: Populações (Pops)",
        categoria: "pops",
        pais_foco: None,
        texto: "Diferente de jogos simplificados de estratégia, em Guerra Fria a nação não é um bloco abstrato: ela é formada por grupos de cidadãos chamados 'Pops'. Cada Pop é definida por três pilares inegociáveis: sua profissão (operários, camponeses, burocratas, capitalistas, clero, acadêmicos, soldados), sua cultura (brasileira, anglo-americana, afro-americana, etc.) e sua religião (católica, protestante, secular, etc.). As Pops trabalham nos prédios da sua província, recebem salários, pagam impostos e consomem mercadorias para sobreviver.",
        objetivo: "Abra o Painel Demográfico e examine a composição social da província de São Paulo (para o Brasil) ou de Nova York / Pensilvânia (para os EUA).",
        elemento_hud: "painel_populacao",
        dica: "No Brasil de 1945, a imensa maioria dos cidadãos ainda é de camponeses no interior. Nos EUA, o forte proletariado fabril urbano e a classe média suburbana definem a economia.",
    ),
    PassoTutorial(
        id: "passo_06_padrao_de_vida_e_radicalismo",
        ordem: 6,
        titulo: "Padrão de Vida: Radicais e Legalistas",
        categoria: "pops",
        pais_foco: None,
        texto: "Cada Pop possui um índice numérico de Padrão de Vida (Standard of Living - SoL) que varia de 1 (miséria extrema e fome) a 99 (opulência aristocrática). O SoL é determinado pela renda líquida da família em relação ao custo da sua cesta de consumo (alimentos básicos, roupas, habitação e combustível). Se o preço da comida sobe ou os salários caem, o SoL diminui e as Pops geram Radicais. Cidadãos radicalizados apoiam greves gerais, boicotes eleitorais e levantes insurrecionais. Por outro lado, quando a qualidade de vida melhora, geram-se Legalistas, que sustentam o governo.",
        objetivo: "Verifique o Padrão de Vida médio da sua população na Top Bar e a proporção de Radicais e Legalistas no país.",
        elemento_hud: "painel_sol_e_radicalismo",
        dica: "Manter o preço dos alimentos básicos (grãos, carne e açúcar) barato no mercado doméstico é a regra de ouro para blindar seu governo contra rebeliões populares.",
    ),
    PassoTutorial(
        id: "passo_07_mercado_nacional_e_acesso",
        ordem: 7,
        titulo: "O Mercado Nacional e Acesso ao Mercado",
        categoria: "mercado",
        pais_foco: None,
        texto: "Todas as províncias sob seu controle participam do seu Mercado Nacional. No entanto, para que uma saca de café de Minas Gerais ou um lingote de aço de Pittsburgh chegue às fábricas e mesas consumidoras, a província produtora necessita de infraestrutura de transporte. Se uma província tem poucas ferrovias e estradas em relação à sua produção, o seu 'Acesso ao Mercado' cai abaixo de 100%. Quando isso ocorre, os bens locais ficam retidos na província (fazendo o preço local desabar por excesso de estoque), enquanto o mercado nacional sofre com desabastecimento e preços inflacionados.",
        objetivo: "Selecione uma província do interior do Brasil (como Goiás ou Mato Grosso) ou do Meio-Oeste americano e verifique o indicador de Acesso ao Mercado.",
        elemento_hud: "painel_mercado_infraestrutura",
        dica: "Antes de construir grandes indústrias pesadas no interior, certifique-se de erguer ferrovias e portos suficientes para garantir 100% de Acesso ao Mercado.",
    ),
    PassoTutorial(
        id: "passo_08_oferta_demanda_e_precos",
        ordem: 8,
        titulo: "Balanço de Mercadorias e Formação de Preços",
        categoria: "mercado",
        pais_foco: None,
        texto: "No Painel de Mercado, você encontra a lista completa de todos os bens da economia, divididos em: Bens de Consumo Básico (grãos, tecidos, móveis rudimentares), Bens Industriais (carvão, ferro, aço, ferramentas, cimento) e Bens Estratégicos (petróleo, urânio, motores, borracha). O preço de cada bem oscila dinamicamente em torno de um 'Preço Base' conforme o equilíbrio entre Produção (oferta) e Consumo (demanda). Se a demanda por aço supera a produção, o preço sobe até +75%, onerando todas as suas fábricas e construções.",
        objetivo: "Abra a aba de Bens no Mercado e filtre pelos bens que estão com indicador de déficit (fundo dourado ou vermelho de alta de preço).",
        elemento_hud: "painel_mercado_bens",
        dica: "Nos EUA em 1945, há abundância de produtos manufaturados, mas alta demanda de matérias-primas globais. No Brasil, produtos manufaturados e maquinários são caros e importados.",
    ),
    PassoTutorial(
        id: "passo_09_setor_de_construcao",
        ordem: 9,
        titulo: "A Capacidade de Construção da Nação",
        categoria: "construcao",
        pais_foco: None,
        texto: "Nada surge do nada. Para construir uma usina siderúrgica, uma ferrovia ou uma fazenda cooperativa, você necessita de 'Pontos de Construção'. Esses pontos são gerados pelos Prédios do Setor de Construção espalhados pelo país. Cada ponto de construção consome ativamente ferro, madeira e cimento do mercado e custa dinheiro diário ao tesouro público. A fila de construção divide o esforço entre o setor público (obras ordenadas pelo jogador) e o setor privado (investimentos autônomos de capitalistas e fazendeiros).",
        objetivo: "Abra o Painel de Construção e inspecione a quantidade de pontos ativos na fila nacional de edificações.",
        elemento_hud: "painel_construcao_fila",
        dica: "Cuidado: expandir muitos prédios de construção sem ter produção nacional barata de aço e cimento pode drenar todo o caixa do Tesouro em poucas semanas.",
    ),
    PassoTutorial(
        id: "passo_10_expandindo_fabricas_e_campo",
        ordem: 10,
        titulo: "Erguendo Prédios e Fábricas",
        categoria: "construcao",
        pais_foco: None,
        texto: "Para sanar a falta de um bem ou gerar empregos de maior remuneração, você pode ordenar a construção de novos prédios em uma província específica. Prédios rurais (fazendas de trigo, plantações de café e algodão) utilizam a Terra Arável disponível e empregam camponeses. Fábricas urbanas (fiação têxtil, siderúrgicas, refinarias químicas) convertem insumos brutos em produtos acabados de alto valor agregado, gerando empregos para operários e engenheiros.",
        objetivo: "No Brasil, selecione a província do Rio de Janeiro ou Minas Gerais e ordene a ampliação de uma Siderúrgica ou Mina de Ferro. Nos EUA, expanda uma Refinaria Química no Texas.",
        elemento_hud: "menu_construcao_provincial",
        dica: "Historicamente, o Brasil de 1945 apostou na Usina Presidente Vargas em Volta Redonda para consolidar sua base pesada. Aço próprio é a chave da soberania.",
    ),
    PassoTutorial(
        id: "passo_11_metodos_de_producao",
        ordem: 11,
        titulo: "Métodos de Produção e Modernização Técnica",
        categoria: "construcao",
        pais_foco: None,
        texto: "Cada prédio no jogo opera através de 'Métodos de Produção' (Production Methods - PMs). Eles determinam: (1) o tipo de tecnologia aplicada, como fornos a carvão versus fornos elétricos Siemens-Martin; (2) o nível de automação da linha de montagem, substituindo braços operários por maquinário motorizado; e (3) o regime de propriedade, como cooperativa estatal, sociedade de capital aberto ou propriedade latifundiária tradicional. Mudar um método altera drasticamente os insumos exigidos, as profissões empregadas e a margem de lucro.",
        objetivo: "Abra a visão detalhada de uma Fábrica Têxtil ou Mina e examine os slots de Métodos de Produção disponíveis.",
        elemento_hud: "painel_predio_metodos",
        dica: "Adotar métodos altamente mecanizados em um país com excesso de camponeses pobres (como o Brasil) pode causar demissões em massa e explosão de desemprego se novas fábricas não absorverem a mão de obra.",
    ),
    PassoTutorial(
        id: "passo_12_emprego_e_salarios",
        ordem: 12,
        titulo: "Mercado de Trabalho, Salários e Qualificação",
        categoria: "pops",
        pais_foco: None,
        texto: "Um prédio construído não produz nada se suas vagas de emprego estiverem vazias. As fábricas contratam Pops conforme a qualificação mínima exigida: enquanto camponeses e braçais não exigem instrução formal, mecânicos, engenheiros e burocratas requerem níveis crescentes de Alfabetização. Se os salários pagos pela indústria forem superiores à renda de subsistência do campo, ocorre o 'Êxodo Rural', transferindo massas de camponeses para os centros fabris e transformando-os em operários conscientes.",
        objetivo: "Verifique o nível de emprego e a taxa de alfabetização na província mais industrializada da sua nação.",
        elemento_hud: "painel_emprego_provincia",
        dica: "Se faltarem engenheiros e técnicos qualificados nas suas usinas, o prédio sofrerá penalidade de rendimento. Invista na expansão de escolas públicas através de leis de educação.",
    ),
    PassoTutorial(
        id: "passo_13_tesouro_e_bretton_woods",
        ordem: 13,
        titulo: "O Tesouro Nacional e a Ordem Monetária",
        categoria: "orcamento",
        pais_foco: None,
        texto: "No centro da Top Bar, você vê as Reservas Financeiras do Tesouro e o Balanço Diário (em US$ da época). Em 1945, o Acordo de Bretton Woods consagrou o dólar norte-americano como moeda de reserva internacional, lastreado em ouro à razão fixa de US$ 35 por onça. Os Estados Unidos detêm mais de dois terços das reservas monetárias de ouro de todo o planeta. Para as demais nações, acumular reservas em dólar e ouro é vital para lastrear sua moeda e pagar importações sem deflagrar desvalorização cambial galopante.",
        objetivo: "Passe o cursor sobre o valor do Tesouro na barra superior e leia o tooltip com a composição das reservas e o lastro monetário.",
        elemento_hud: "top_bar_reservas_tesouro",
        dica: "Manter o balanço diário no verde evita ter de contrair empréstimos com bancos estrangeiros ou emitir moeda inflacionária sem lastro real.",
    ),
    PassoTutorial(
        id: "passo_14_receitas_tributarias",
        ordem: 14,
        titulo: "Receitas do Estado: Impostos e Tarifas",
        categoria: "orcamento",
        pais_foco: None,
        texto: "Abra o Livro-Razão Fiscal clicando sobre o Balanço Diário. As receitas do Estado provêm de quatro fontes primordiais: (1) Imposto de Renda, que incide diretamente sobre os salários de trabalhadores e dividendos de capitalistas; (2) Impostos sobre Consumo, cobrados sobre bens específicos como tabaco, destilados e automóveis; (3) Tarifas Alfandegárias cobradas nas alfândegas portuárias de importação e exportação; e (4) Lucros de Empresas Estatais monopolizadas pelo poder público.",
        objetivo: "Abra a aba de Receitas no Painel de Orçamento e observe quais tributos geram o maior volume diário de divisas.",
        elemento_hud: "painel_orcamento_receitas",
        dica: "Aumentar os impostos de consumo gera receita rápida, mas empobrece desproporcionalmente as famílias de baixa renda, deprimindo o Padrão de Vida e elevando os Radicais.",
    ),
    PassoTutorial(
        id: "passo_15_despesas_publicas_e_divida",
        ordem: 15,
        titulo: "Despesas Governamentais e Gestão da Dívida",
        categoria: "orcamento",
        pais_foco: None,
        texto: "No lado das despesas, o orçamento público é consumido por: soldos das forças armadas e manutenção de navios e divisões ativas; salários da burocracia estatal (que garantem a arrecadação fiscal e a segurança pública); insumos do setor de construção; e subsídios para evitar o colapso de ferrovias estratégicas. Se suas despesas superarem as receitas continuamente, você entrará em déficit e acumulará dívida pública. Dívidas elevadas cobram juros pesados e arriscam uma moratória que destruirá sua reputação financeira global.",
        objetivo: "Examine a coluna de despesas públicas no painel fiscal e identifique o custo diário do seu aparato militar.",
        elemento_hud: "painel_orcamento_despesas",
        dica: "Com o encerramento da 2ª Guerra Mundial em 1945, desmobilizar gradualmente divisões excedentes permite aos EUA e ao Brasil cortar dezenas de milhares de dólares diários de custos.",
    ),
    PassoTutorial(
        id: "passo_16_grupos_de_interesse",
        ordem: 16,
        titulo: "As Forças Políticas: Grupos de Interesse (GIs)",
        categoria: "politica",
        pais_foco: None,
        texto: "A política interna é disputada por Grupos de Interesse (GIs). Cada grupo representa um segmento orgânico da sociedade com ideologia própria e reivindicações institucionais. Os Latifundiários e Fazendeiros defendem o poder agrário tradicional e livre comércio de matérias-primas. Os Industriais prezam pelo lucro, investimento e contenção sindical. As Forças Armadas priorizam disciplina, ordem e orçamento bélico. Os Trabalhadores Sindicalizados exigem seguridade social, salários dignos e direitos civis. E os Intelectuais cobram democracia e secularismo.",
        objetivo: "Abra o Painel Político e examine a Força Política (Clout %) de cada um dos Grupos de Interesse na sua nação.",
        elemento_hud: "painel_politica_grupos",
        dica: "A Força Política de um grupo depende da riqueza somada dos cidadãos que o integram e das leis eleitorais vigentes. Em sistemas censitários, os ricos monopolizam o poder.",
    ),
    PassoTutorial(
        id: "passo_17_gabinete_e_legitimidade",
        ordem: 17,
        titulo: "Compondo o Governo: Coalizão e Legitimidade",
        categoria: "politica",
        pais_foco: None,
        texto: "Você governa através do seu Gabinete Ministerial. Grupos de Interesse podem estar 'No Governo' (formando a coalizão de poder), 'Na Oposição' (fiscalizando e bloqueando pautas) ou 'Marginalizados' (quando sua força política é inferior a 5%). A proporção e afinidade ideológica dos grupos no governo determinam a 'Legitimidade Governamental' (0 a 100%). Uma legitimidade acima de 75% acelera a aprovação de reformas legais. Se a legitimidade cair abaixo de 25%, seu governo ficará paralisado por crises de gabinete e ameaça de golpe de Estado.",
        objetivo: "Inspecione o indicador de Legitimidade na barra superior e veja quais grupos compõem atualmente o seu gabinete de governo.",
        elemento_hud: "top_bar_legitimidade",
        dica: "Evite formar coalizões Frankenstein com grupos mutuamente antagônicos (ex: Sindicatos Operários e Barões Latifundiários juntos), pois a incoerência ideológica destrói a legitimidade.",
    ),
    PassoTutorial(
        id: "passo_18_processo_legislativo",
        ordem: 18,
        titulo: "O Processo Legislativo e a Aprovação de Leis",
        categoria: "politica",
        pais_foco: None,
        texto: "As leis definem o arcabouço do Estado: Distribuição de Poder, Sistema Econômico, Direitos Trabalhistas, Liberdades Civis e Tributação. Para aprovar uma nova lei, é necessário iniciar a tramitação formal no Congresso ou Conselho de Estado. O projeto passa por três leituras sucessivas (Primeira Leitura, Comissões e Votação Final). A cada ciclo de 60 a 90 dias, ocorre uma rolagem com base no apoio parlamentar: o projeto pode Avançar, Enfrentar Debate com emendas ou Estagnar. Grupos de oposição contrários à reforma perdem aprovação e podem planejar insurreições armadas.",
        objetivo: "Selecione uma lei compatível com a ideologia dos grupos no poder e inicie sua tramitação no Parlamento.",
        elemento_hud: "painel_leis_tramitacao",
        dica: "Nunca tente promulgar uma lei odiada por grupos poderosos e armados (como Militares ou Latifundiários) sem antes enfraquecer o apoio popular desses grupos.",
    ),
    PassoTutorial(
        id: "passo_19_brasil_redemocratizacao",
        ordem: 19,
        titulo: "O Desafio Brasileiro: Redemocratização e o Fim do Estado Novo",
        categoria: "politica",
        pais_foco: Some("BRA"),
        texto: "No Brasil em 1945, Getúlio Vargas governa sob o regime autoritário do Estado Novo, instituído em 1937. Contudo, após o envio da Força Expedicionária Brasileira (FEB) para combater o fascismo na Itália, a contradição entre lutar pela liberdade no exterior e manter uma ditadura em casa tornou a abertura política inevitável. Forças liberais e militares conservadores articulam a deposição de Vargas e a convocação de eleições presidenciais e de uma Assembleia Constituinte. Como governante do Brasil, você terá de conduzir a transição pacífica ou enfrentar levantes militares e greves gerais do operariado queremista.",
        objetivo: "Inspecione o quadro político brasileiro, o peso dos Militares e dos Latifundiários, e prepare o caminho para eleições democráticas e a nova Constituição de 1946.",
        elemento_hud: "painel_evento_nacional_brasil",
        dica: "A industrialização nacional iniciada por Vargas com estatais (CSN, Vale) precisa ser preservada para garantir a soberania econômica frente à pressão externa.",
    ),
    PassoTutorial(
        id: "passo_20_eua_superpotencia",
        ordem: 20,
        titulo: "A Responsabilidade Americana: A Arquiteta do Mundo Livre",
        categoria: "politica",
        pais_foco: Some("USA"),
        texto: "Nos Estados Unidos sob a presidência de Harry S. Truman, o desafio imediato de 1945 é duplo: reconverter a colossal indústria bélica americana para uma próspera economia civil de consumo e evitar que a Europa devastada pela guerra caia na órbita comunista da União Soviética de Stalin. Você conta com monopólio atômico inicial e uma frota militar insuperável, mas seu público doméstico exige a desmobilização dos soldados e corte de gastos emergenciais de guerra. Sua tarefa é estruturar alianças globais e manter a prosperidade sem descambar para o isolacionismo.",
        objetivo: "Abra o mapa da Europa e examine a vulnerabilidade dos países ocidentais exauridos pela guerra (França, Itália, Reino Unido e Alemanha Ocupada).",
        elemento_hud: "painel_geopolitica_eua",
        dica: "A liderança hegemônica dos EUA exige o uso inteligente do poder econômico: financiar a reconstrução de aliados garante mercados cativos para suas exportações.",
    ),
    PassoTutorial(
        id: "passo_21_diplomacia_e_relacoes",
        ordem: 21,
        titulo: "Diplomacia e Relações Bilaterais",
        categoria: "diplomacia",

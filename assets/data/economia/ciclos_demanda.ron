// Tabela histórica de ciclos estruturais de demanda, substituição tecnológica e choques
// de oferta/demanda de recursos na Guerra Fria (1945–1991+).
//
// IMPORTANTE: Nenhum preço é fixado manualmente aqui. Todos os parâmetros atuam apenas
// sobre:
//   1. `fator_demanda`: intensidade de uso industrial/geral do bem no mercado;
//   2. `fator_peso_pop`: preferência relativa das famílias dentro das cestas de substituição
//      (`SubstituicaoNecessidade` em `bens.ron`), sem alterar a renda total nem a Lei de Engel;
//   3. `fator_procura_estrategica`: encomendas estratégicas/governamentais de estocagem
//      (ex.: programas de armas nucleares da AEC/URSS para `uranio`, aeroespacial para `aluminio`),
//      escaladas pela capacidade física instalada de 1945;
//   4. `fator_absorcao_excedente`: apetite do mercado externo residual por excedentes quando
//      há escassez global (> 0.8) versus superoferta estrutural mundial (< 0.25);
//   5. `multiplicador_oferta_importacao_residual` em choques históricos (ex.: embargos de 1973/1979).
// Os preços reagem exclusivamente pela equação de fechamento de oferta e demanda do mercado.
(
    curvas: [
        // =========================================================================
        // 1. URÂNIO: corrida nuclear pós-1945 (Manhattan, RDS-1, bombas H, AEC)
        //    seguida de saturação de estoques, centrífugas, TNP (1970), Three Mile
        //    Island (1979), Chernobyl (1986), INF/START (1987) e excesso de oferta.
        // =========================================================================
        (
            bem_id: "uranio",
            referencia_historica: "Corrida de arsenais nucleares EUA/URSS e compras garantidas da AEC (1946–1959), seguida de saturação militar, TNP (1970), Three Mile Island (1979), Chernobyl (1986) e desarmamento INF/START.",
            amplitude_desvio_anos: 2.2,
            amplitude_variacao_partida: 0.16,
            amplitude_ciclo_curto: 0.08,
            pontos_era: [

    // --------------------------------------------------------------------------
    // 137. A ASSINATURA DO TRATADO START I DE REDUÇÃO DE ARMAS ESTRATÉGICAS (1991)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "tratado_start_i_moscou_1991",
        titulo: "A Assinatura do Tratado START I de Redução de Armas Estratégicas",
        descricao: "Em 31 de julho de 1991, em cerimônia no Salão de São Jorge do Kremlin em Moscou, George H.W. Bush e Mikhail Gorbachev assinam o Tratado de Redução e Limitação de Armas Ofensivas Estratégicas (START I). Diferentemente dos acordos SALT anteriores que apenas congelavam arsenais, o START I determina cortes reais e profundos de cerca de 30% a 40% nas ogivas nucleares estratégicas de ambas as superpotências, limitando cada lado a 6.000 ogivas distribuídas em no máximo 1.600 mísseis balísticos e bombardeiros pesados.",
        data_gatilho: DataGatilho(ano: 1991, mes: 7, dia: 31),
        paises_alvo: ["USA", "SOV"],
        condicoes: ["cupula_moscou_start"],
        opcoes: [
            OpcaoEvento(
                id: "start1_ratificar_cortes_estrategicos_massivos",
                texto: "Ratificar o START I e desativar milhares de mísseis balísticos intercontinentais e bombardeiros pesados",
                descricao_resultado: "Representa o ápice da diplomacia de controle de armas da Guerra Fria e garante que o gigantesco arsenal nuclear soviético permaneça sob rígido controle técnico.",

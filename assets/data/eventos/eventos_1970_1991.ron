    // --------------------------------------------------------------------------
    // 2. A OSTPOLITIK DE WILLY BRANDT E O TRATADO DE MOSCOU (1970)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "tratado_moscou_ostpolitik_1970",
        titulo: "A Ostpolitik de Willy Brandt e o Tratado de Moscou",
        descricao: "Em agosto de 1970, o chanceler da Alemanha Ocidental, Willy Brandt, e o primeiro-ministro soviético Alexei Kosygin assinam o Tratado de Moscou. Sob o lema 'mudança através da aproximação' (Wandel durch Annäherung), Bonn reconhece formalmente a inviolabilidade das fronteiras europeias do pós-guerra, incluindo a Linha Oder-Neisse e a fronteira interalemã.",
        data_gatilho: DataGatilho(ano: 1970, mes: 8, dia: 12),
        paises_alvo: ["FRG", "SOV"],
        condicoes: ["era_destensao"],

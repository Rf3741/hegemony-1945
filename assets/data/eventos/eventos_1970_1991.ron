    // --------------------------------------------------------------------------
    // 34. A ATA FINAL DE HELSINQUE E A CONFERÊNCIA SOBRE SEGURANÇA EUROPEIA (CSCE) (1975)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "acordos_helsinque_csce_1975",
        titulo: "A Ata Final de Helsinque e a Conferência sobre Segurança Europeia (CSCE)",
        descricao: "Em 1º de agosto de 1975, líderes de 35 nações europeias e norte-americanas assinam a Ata Final da Conferência sobre Segurança e Cooperação na Europa (CSCE) em Helsinque. O documento consagra três 'cestas' de compromissos: a inviolabilidade das fronteiras pós-Segunda Guerra Mundial (atendendo ao pleito de Moscou), cooperação econômica e científica, e a histórica 'Cesta 3', que obriga os signatários a respeitarem os direitos humanos e as liberdades fundamentais, servindo de base jurídica para os movimentos dissidentes no bloco comunista.",
        data_gatilho: DataGatilho(ano: 1975, mes: 8, dia: 1),
        paises_alvo: ["SOV", "USA", "FRG", "GDR", "GBR", "FRA"],
        condicoes: ["era_destensao"],

    // --------------------------------------------------------------------------
    // 1. ENTRADA EM VIGOR DO TRATADO DE NÃO-PROLIFERAÇÃO NUCLEAR (TNP) (1970)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "tratado_nao_proliferacao_tnp_1970",
        titulo: "Entrada em Vigor do Tratado de Não-Proliferação Nuclear (TNP)",
        descricao: "Em 5 de março de 1970, entra em vigor formal o Tratado de Não-Proliferação de Armas Nucleares (TNP). O acordo consagra as cinco potências nucleares reconhecidas (EUA, URSS, Reino Unido, França e China) e estabelece a renúncia voluntária das demais nações ao desenvolvimento de artefatos atômicos em troca de cooperação para energia nuclear civil.",
        data_gatilho: DataGatilho(ano: 1970, mes: 3, dia: 5),
        paises_alvo: ["USA", "SOV", "GBR"],
        condicoes: ["corrida_armamentista_nuclear"],
        opcoes: [
            OpcaoEvento(
                id: "tnp_ratificar_regime_inspecao",
                texto: "Ratificar o tratado e fortalecer o regime de salvaguardas da AIEA",
                descricao_resultado: "Reforça a estabilidade estratégica bipolar e reduz o perigo de proliferação atômica horizontal em regiões de conflito crônico.",
                efeitos: [
                    Modificador(id: "tensao_guerra_fria", valor: -0.15),
                    Modificador(id: "legitimidade_internacional", valor: 20.0),
                    Modificador(id: "aprovacao_intelectuais", valor: 15.0),
                    Modificador(id: "cooperacao_nuclear", valor: 0.25),
                ],
                ia_peso: 85,
            ),
            OpcaoEvento(
                id: "tnp_denunciar_duplo_padrao",
                texto: "Denunciar a assimetria do tratado como monopólio discriminatório das superpotências",
                descricao_resultado: "Preserva a soberania nacional e a autonomia tecnológica irrestrita, sob protestos contundentes das capitais hegemônicas.",
                efeitos: [
                    Modificador(id: "tensao_guerra_fria", valor: 0.15),
                    Modificador(id: "aprovacao_militares", valor: 15.0),
                    Modificador(id: "legitimidade_internacional", valor: -10.0),
                ],
                ia_peso: 15,

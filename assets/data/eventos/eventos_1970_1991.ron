    // --------------------------------------------------------------------------
    // 8. O CHOQUE NIXON E O COLAPSO DO PADRÃO OURO-DÓLAR (1971)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "choque_nixon_fim_bretton_woods_1971",
        titulo: "O Choque Nixon e o Colapso do Padrão Ouro-Dólar",
        descricao: "Em 15 de agosto de 1971, enfrentando déficit crônico na balança de pagamentos, inflação interna e drenagem acelerada de suas reservas em ouro para capitais europeias, o presidente Richard Nixon anuncia a suspensão unilateral da conversibilidade do dólar em ouro (35 dólares por onça) e impõe sobretaxa tarifária de 10%. O sistema monetário de Bretton Woods entra em colapso, inaugurando a era das taxas de câmbio flutuantes.",
        data_gatilho: DataGatilho(ano: 1971, mes: 8, dia: 15),
        paises_alvo: ["USA", "GBR", "FRA", "FRG", "JAP"],
        condicoes: ["crise_financeira_internacional"],

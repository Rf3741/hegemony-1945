    // --------------------------------------------------------------------------
    // 139. O ACORDO DE BELAVEZHA E A DISSOLUÇÃO DA UNIÃO SOVIÉTICA (1991)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "acordo_belavezha_fim_urss_1991",
        titulo: "O Acordo de Belavezha e a Dissolução da União Soviética",
        descricao: "Em 8 de dezembro de 1991, em uma residência de caça governamental na floresta de Belavezha, próxima a Brest, na Bielorrússia, os presidentes das três repúblicas fundadoras e eslavas da URSS — Boris Yeltsin (Rússia), Leonid Kravchuk (Ucrânia, recém-independente após referendo esmagador com 90% dos votos) e Stanislav Shushkevich (Bielorrússia) — reúnem-se em segredo. Assinam o histórico Acordo de Belavezha, declarando solenemente que 'a União das Repúblicas Socialistas Soviéticas, como sujeito de direito internacional e realidade geopolítica, deixa de existir', criando em seu lugar a Comunidade de Estados Independentes (CEI).",
        data_gatilho: DataGatilho(ano: 1991, mes: 12, dia: 8),
        paises_alvo: ["SOV"],
        condicoes: ["dissolucao_territorial_urss"],

    // --------------------------------------------------------------------------
    // 140. A RENÚNCIA DE GORBACHEV E O ARRIAMENTO DA BANDEIRA VERMELHA NO KREMLIN (1991)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "renuncia_gorbachev_arriamento_bandeira_1991",
        titulo: "A Renúncia de Gorbachev e o Arriamento da Bandeira Vermelha no Kremlin",
        descricao: "Na noite de Natal, 25 de dezembro de 1991, às 19h00, em discurso televisionado em rede mundial ao vivo a partir de seu gabinete no Kremlin, Mikhail Gorbachev anuncia sua renúncia irrevogável ao cargo de Presidente da União Soviética: 'O destino ditou que, no momento em que me vi à frente deste Estado, já estava claro que o país estava doente... Mas o processo de renovação e reformas democráticas era indispensável... Deixo minhas funções com inquietação, mas também com esperança'. Às 19h32, a bandeira vermelha soviética com a foice e o martelo é arriada do mastro mais alto do Kremlin após 74 anos e a bandeira tricolor da Federação Russa é hasteada em seu lugar. A Guerra Fria termina oficialmente.",
        data_gatilho: DataGatilho(ano: 1991, mes: 12, dia: 25),
        paises_alvo: ["SOV", "USA"],
        condicoes: ["fim_da_urss"],

    // --------------------------------------------------------------------------
    // 90. A MORTE DE ANDROPOV E A BREVE ERA DE KONSTANTIN CHERNENKO (1984)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "morte_andropov_chernenko_1984",
        titulo: "A Morte de Andropov e a Breve Era de Konstantin Chernenko",
        descricao: "Em 9 de fevereiro de 1984, após apenas 15 meses de governo e meses dependente de hemodiálise, morre Yuri Andropov aos 69 anos. Demonstrando a relutância da velha guarda em entregar as rédeas a líderes mais jovens como Gorbachev, a gerontocracia do Politburo elege o frágil Konstantin Chernenko, de 72 anos, gravemente doente com enfisema pulmonar. Sua gestão de treze meses simboliza o ápice caricatural do imobilismo senil soviético.",
        data_gatilho: DataGatilho(ano: 1984, mes: 2, dia: 9),
        paises_alvo: ["SOV"],

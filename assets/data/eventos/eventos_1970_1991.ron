    // --------------------------------------------------------------------------
    // 138. O GOLPE DE ESTADO DE AGOSTO EM MOSCOU (GKCHP) E A RESISTÊNCIA DE YELTSIN (1991)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "golpe_de_agosto_gkchp_moscou_1991",
        titulo: "O Golpe de Estado de Agosto em Moscou (GKChP) e a Resistência de Yeltsin",
        descricao: "Na madrugada de 19 de agosto de 1991, véspera da assinatura do Novo Tratado da União que descentralizaria o poder para as repúblicas soviéticas, a linha-dura do regime — incluindo o vice-presidente Yanayev, o chefe do KGB Kryuchkov e o ministro da Defesa Yazov — toma o poder e forma o 'Comitê Estatal sobre o Estado de Emergência' (GKChP). Gorbachev é mantido incomunicável sob prisão domiciliar em sua dacha na Crimeia. Em Moscou, colunas de blindados cercam a Casa Branca (Parlamento russo), onde Boris Yeltsin sobe em cima de um tanque T-72, conclama o povo à greve geral e lidera a resistência civil que esmaga o golpe em três dias.",
        data_gatilho: DataGatilho(ano: 1991, mes: 8, dia: 19),
        paises_alvo: ["SOV"],
        condicoes: ["crise_terminal_urss"],

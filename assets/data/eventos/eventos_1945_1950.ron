[
    // --------------------------------------------------------------------------
    // 1. CONFERÊNCIA DE YALTA (Fevereiro de 1945)
    // --------------------------------------------------------------------------
    EventoHistorico(
        id: "conferencia_yalta_1945",
        titulo: "A Conferência de Yalta e a Partilha da Europa",
        descricao: "No Palácio de Livadia, na Crimeia, os 'Três Grandes' (Roosevelt, Stalin e Churchill) reúnem-se para traçar o mapa do pós-guerra na Europa. Debatem as quatro zonas de ocupação na Alemanha, as fronteiras da Polônia com a Linha Curzon e a promessa soviética de eleições livres no Leste e entrada na guerra contra o Japão.",
        data_gatilho: DataGatilho(ano: 1945, mes: 2, dia: 11),
        paises_alvo: ["USA", "SOV", "GBR"],
        condicoes: [
            "guerra_na_europa_em_andamento",
        ],
        opcoes: [
            OpcaoEvento(
                id: "yalta_acordo_historico",
                texto: "Ratificar a Declaração sobre a Europa Libertada e as Zonas de Ocupação",
                descricao_resultado: "Garante a entrada soviética na guerra do Pacífico e o compromisso solene com a fundação das Nações Unidas, ao custo de aceitar a esfera de influência soviética na Polônia e nos Bálcãs.",
                efeitos: [
                    Modificador(id: "tensao_guerra_fria", valor: 0.10),
                    Modificador(id: "progresso_fundacao_onu", valor: 0.35),
                    Modificador(id: "legitimidade_internacional", valor: 15.0),
                    Modificador(id: "aprovacao_intelectuais", valor: 5.0),
                ],
                ia_peso: 85,
            ),
            OpcaoEvento(
                id: "yalta_posicao_intransigente",
                texto: "Exigir eleições supervisionadas imediatamente e rejeitar concessões na Polônia",
                descricao_resultado: "Gera atrito imediato com Moscou; a URSS ameaça não participar da conferência de São Francisco nem declarar guerra ao Império do Japão.",
                efeitos: [
                    Modificador(id: "tensao_guerra_fria", valor: 0.35),
                    Modificador(id: "hostilidade_eua_urss", valor: 0.40),
                    Modificador(id: "aprovacao_militares", valor: 10.0),
                    Modificador(id: "aprovacao_partido_comunista", valor: -15.0),

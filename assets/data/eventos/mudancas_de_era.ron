    MarcoDeEra(
        id: "morte_de_stalin",
        titulo: "A Morte de Josef Stalin e a Transição Soviética",
        era: "era_pos_guerra_1945",
        descricao: "Em março de 1953, o falecimento do líder supremo da União Soviética abre uma disputa fratricida no Politburo entre Beria, Malenkov, Molotov e Khrushchev. O desaparecimento de Stalin encerra a era do terror absoluto, abre espaço para a reabilitação de prisioneiros do Gulag e desencadeia incerteza profunda em todo o bloco comunista.",

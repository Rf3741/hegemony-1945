    // --------------------------------------------------------------------------
    // 120. A MISSÃO APOLLO 11 NO MAR DA TRANQUILIDADE: O PRIMEIRO PASSO HUMANO NA LUA (Julho de 1969)
    // --------------------------------------------------------------------------

    EventoHistorico(
        id: "pouso_lunar_apollo_11_1969",
        titulo: "A Missão Apollo 11 no Mar da Tranquilidade: O Primeiro Passo Humano na Lua",
        descricao: "Às 20h17 UTC de 20 de julho de 1969, o módulo lunar Eagle pousa suavemente no Mar da Tranquilidade com apenas 25 segundos restantes de combustível nos tanques. O comandante Neil Armstrong transmite ao controle de Houston a histórica mensagem: 'Houston, aqui Base da Tranquilidade. O Eagle pousou'. Seis horas depois, Armstrong pisa na poeira lunar declarando perante mais de 600 milhões de telespectadores na Terra: 'Este é um pequeno passo para um homem, mas um salto gigantesco para a humanidade'. A conquista cumpre a meta de JFK e consagra a vitória dos EUA na Corrida Espacial.",

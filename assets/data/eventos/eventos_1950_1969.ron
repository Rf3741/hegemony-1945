    // 102. A SEGUNDA GUERRA INDO-PAQUISTANESA E A DECLARAÇÃO DE TASHKENT (Setembro de 1965)
    // --------------------------------------------------------------------------

    EventoHistorico(
        id: "segunda_guerra_indo_paquistanesa_1965",
        titulo: "A Segunda Guerra Indo-Paquistanesa e a Declaração de Tashkent",
        descricao: "Após a tentativa do Paquistão (Operação Gibraltar) de infiltrar guerrilheiros armados no vale da Caxemira para fomentar um levante contra a Índia, o exército indiano cruza a fronteira internacional lançando uma ofensiva blindada direta contra Lahore. O maior confronto de blindados desde Kursk envolve mais de mil tanques Patton e Centurion. Após semanas de combates exaustivos e sob embargo militar anglo-americano a ambos os lados, o premiê soviético Alexei Kosygin atua como mediador e patrocina o cessar-fogo com a Declaração de Tashkent.",
        data_gatilho: DataGatilho(ano: 1965, mes: 9, dia: 6),
        paises_alvo: ["IND", "PAK", "SOV"],
        condicoes: [
            "ano >= 1965",
            "soberano:IND",
            "soberano:PAK",

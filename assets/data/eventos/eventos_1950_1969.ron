[
    // --------------------------------------------------------------------------
    // 1. A DIRETIVA DE TRUMAN PARA A SUPERBOMBA TERMONUCLEAR (Janeiro de 1950)
    // --------------------------------------------------------------------------

    EventoHistorico(
        id: "truman_bomba_hidrogenio_1950",
        titulo: "A Diretiva de Truman para a Superbomba Termonuclear",
        descricao: "Em resposta ao primeiro teste atômico soviético 'Primeiro Raio' (Joe-1) em Semipalatinsk, o presidente Harry S. Truman ordena publicamente à Comissão de Energia Atômica dos EUA o desenvolvimento prioritário da 'Superbomba' de fusão termonuclear (Bomba de Hidrogênio), contrariando os alertas morais e científicos do comitê de J. Robert Oppenheimer.",
        data_gatilho: DataGatilho(ano: 1950, mes: 1, dia: 31),
        paises_alvo: ["USA", "SOV"],
        condicoes: [
            "ano >= 1950",
            "pos_evento:primeiro_teste_nuclear_sovietico_1949",
            "corrida_armamentista_nuclear >= 0.5",
        ],
        opcoes: [
            OpcaoEvento(
                id: "truman_hbomb_acelerar_maximo",
                texto: "Acelerar com prioridade nacional máxima o Projeto Termonuclear",
                descricao_resultado: "Mobiliza laboratórios em Los Alamos e cria a base de Livermore sob comando de Edward Teller, garantindo que os EUA mantenham supremacia no poder destrutivo global.",
                efeitos: [
                    Modificador(id: "corrida_armamentista_nuclear", valor: 0.40),
                    Modificador(id: "tensao_guerra_fria", valor: 0.20),
                    Modificador(id: "capacidade_destrutiva_estrategica", valor: 0.50),
                    Modificador(id: "aprovacao_militares", valor: 15.00),
                    Modificador(id: "aprovacao_intelectuais", valor: -10.00),
                ],
                ia_peso: 85,
            ),
            OpcaoEvento(
                id: "truman_hbomb_moratoria_proposta_onu",
                texto: "Propor uma moratória bilateral com controle internacional estrito na ONU",
                descricao_resultado: "Tenta congelar a corrida termonuclear antes do ponto de não-retorno, mas a liderança soviética interpreta a hesitação como sinal de fraqueza ocidental.",
                efeitos: [
                    Modificador(id: "tensao_guerra_fria", valor: -0.15),
                    Modificador(id: "legitimidade_internacional", valor: 20.00),
                    Modificador(id: "aprovacao_militares", valor: -15.00),
